# Copy to .env for LOCAL mode only. .env is gitignored.
# In cloud routines, set these as environment variables on the routine itself —
# do NOT create a .env file in the cloud.
#
# NOTE: .env is a FALLBACK. A value already exported in the environment wins,
# so `BYBIT_ENDPOINT=https://api.bybit.com bash scripts/bybit.sh account` works
# for one-off checks without editing this file.

# Bybit V5 — DEMO TRADING.
# Demo keys are ONLY valid on api-demo.bybit.com; mainnet returns 10003.
# Verify before trusting a key:
#   BYBIT_ENDPOINT=https://api.bybit.com bash scripts/bybit.sh account
# MUST return 10003. If it returns OK, the key is a MAINNET key with real funds
# — stop and replace it.
BYBIT_ENDPOINT=https://api-demo.bybit.com
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_RECV_WINDOW=10000

# The virtual book. The demo ACCOUNT holds ~$181k and cannot be reduced, so the
# bot tracks a $200 book isolated by the BOT_TAG orderLinkId prefix instead.
# Changing BOOK_SIZE changes every percentage rule (fee budget, circuit breaker,
# position sizing) — it is not a display setting.
BOOK_SIZE=200
BOT_TAG=tb

# Perplexity (research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# ClickUp (notifications — posts to a Chat channel)
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_clickup_workspace_id_here
CLICKUP_CHANNEL_ID=your_clickup_channel_id_here
