# Copy to .env for LOCAL mode only. .env is gitignored.
# In cloud routines, set these as environment variables on the routine itself —
# do NOT create a .env file in the cloud.

# Bybit v5 (LIVE MONEY — this is not a paper account)
# Create the key at Bybit -> API Management with:
#   - permissions: Read + Trade ONLY. NEVER enable Withdraw.
#   - IP binding if your machine has a stable address.
# If a key is ever pasted into a chat, a screenshot, a commit or a log, treat it
# as compromised and rotate it immediately — anyone holding it can trade.
BYBIT_ENDPOINT=https://api.bybit.com
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Alpaca — retained only so old paper-era logs remain reproducible. Unused.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Perplexity (research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# ClickUp (notifications — posts to a Chat channel)
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_clickup_workspace_id_here
CLICKUP_CHANNEL_ID=your_clickup_channel_id_here
